{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/docs/stop-hook.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/docs/cg-nudge-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

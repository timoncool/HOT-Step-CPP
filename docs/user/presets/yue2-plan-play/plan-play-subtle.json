{
  "name": "Plan Play: Subtle",
  "backend": "yue2",
  "description": "Slightly looser plan at the start plus a touch of CADS noise.",
  "data": {
    "_format": "hot-step-preset",
    "_version": 2,
    "_mergeMaps": true,
    "backendParams": {
      "yue2NarSolver": "stock",
      "yue2NarScheduler": "stock",
      "yue2CadsStrength": 0.01,
      "yue2CadsT1": 0.6,
      "yue2CadsT2": 0.9,
      "yue2CadsRescale": true,
      "yue2PlanWStart": 0.9,
      "yue2PlanWEnd": 1,
      "yue2PlanWCurve": "linear",
      "yue2PlanCfg": 1,
      "yue2PlanCfgT1": 0,
      "yue2PlanCfgT2": 1,
      "yue2PlanCfgRescale": 0.7,
      "yue2PlanCfgLevelMatch": true
    },
    "pluginParams": {
      "md_ancestral_yue2:churn": 0,
      "md_plan_loose_yue2:loose": 0.5,
      "md_plan_loose_yue2:lock_at": 0.5
    }
  }
}
